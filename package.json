{
  "name": "casamoner-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "build:local": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "images": "node scripts/prepare-images.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "jsdom": "30.1.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
